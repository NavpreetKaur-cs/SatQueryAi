# Leave unset to run entirely against the in-browser mock backend
# (src/api/mockBackend.js) — the app is fully demoable with no value here.
#
# Once the real FastAPI inference service is deployed, set this to its
# base URL and src/api/client.js will start calling POST {url}/query
# instead of the mock. See the comment at the top of src/api/client.js
# for the exact request/response contract it expects.
VITE_API_BASE_URL=
